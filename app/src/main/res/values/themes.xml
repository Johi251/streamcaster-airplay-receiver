<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AirPlayServer" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.StreamCaster" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0D12</item>
        <item name="android:colorBackground">#0B0D12</item>
        <item name="android:statusBarColor">#0B0D12</item>
        <item name="android:navigationBarColor">#0B0D12</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <!-- API 27+. Older platforms ignore theme attributes they do not know, so
             this can stay in the base file; duplicating the whole style into
             values-v27/ just to move one line would be worse. -->
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>
</resources>
